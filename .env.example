# BASE DE DATOS (PostgreSQL + pgvector)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=gestion_personas

# URL activa para SQLAlchemy y Alembic:
DATABASE_URL=postgresql+asyncpg://admin:admin123@postgres-db:5432/gestion_personas

# AUTENTICACIÓN (SSO ROBLE / mock)
# mock = usuarios de prueba sin contrato ROBLE; roble = SDK oficial de Uninorte
AUTH_MODE=mock
ROBLE_BASE_URL=https://roble-api.openlab.uninorte.edu.co
ROBLE_CONTRACT_ID=
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=
# Generar con: openssl rand -hex 32 (lo usa n8n para pedir token de servicio)
SERVICE_API_KEY=

# COMUNICACIÓN INTERNA DE MICROSERVICIOS
LOGS_SERVICE_URL=http://ms-logs:8000
AUTH_SERVICE_URL=http://ms-auth:8000
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=2

# IA / RAG (OpenRouter: una sola key para embeddings y LLM)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBED_DIMENSIONS=768
OPENROUTER_LLM_MODEL=openrouter/free

# AUTOMATIZACIÓN (n8n)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost/n8n/
GENERIC_TIMEZONE=America/Bogota
N8N_USER=admin
N8N_PASSWORD=cambiar_clave_n8n

# Owner de n8n pre-aprovisionado (evita el asistente de configuración inicial).
# Generar el hash con: htpasswd -bnBC 10 "" "$N8N_PASSWORD" | tr -d ':\n'
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=admin@proyecto.local
N8N_INSTANCE_OWNER_FIRST_NAME=Admin
N8N_INSTANCE_OWNER_LAST_NAME=Proyecto
N8N_INSTANCE_OWNER_PASSWORD_HASH=

# FRONTEND (Vite) — se usará cuando se conecte la UI
VITE_API_URL=/api/v1
VITE_N8N_CHAT_URL=http://localhost/n8n/webhook/chat

# n8n 2.x bloquea $env en nodos por defecto; el workflow lo necesita para OpenRouter.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
