# BASE DE DATOS (PostgreSQL + pgvector)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=gestion_personas

# URL activa para SQLAlchemy y Alembic:
DATABASE_URL=postgresql+asyncpg://admin:admin123@postgres-db:5432/gestion_personas

# AUTENTICACIÓN SSO ROBLE (Universidad del Norte)
ROBLE_BASE_URL=https://roble-api.openlab.uninorte.edu.co
ROBLE_DB_NAME=tu_db_name_en_roble
JWT_SECRET_KEY=cambia_esta_clave_secreta_para_firmas_internas
JWT_ALGORITHM=HS256

# COMUNICACIÓN INTERNA DE MICROSERVICIOS
LOGS_SERVICE_URL=http://ms-logs:8000
AUTH_SERVICE_URL=http://ms-auth:8000
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=2

# AUTOMATIZACIÓN Y RAG (n8n)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost/n8n/
GENERIC_TIMEZONE=America/Bogota


# MODELOS DE IA (Embeddings & LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# FRONTEND (Vite)
VITE_API_URL=/api/v1
VITE_N8N_CHAT_URL=http://localhost/n8n/webhook/chat